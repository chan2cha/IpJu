# Milestone 1은 환경변수나 외부 서비스 키가 필요하지 않습니다.
# 홈 화면 앱 설치(PWA)에도 추가 환경변수는 없으며, 실제 모바일 설치에는 HTTPS 배포가 필요합니다.
# Supabase 연동 대상입니다. 현재 시제품은 아직 이 변수를 사용하지 않습니다.
# 연동 구현 시 .env.local과 Vercel Environment Variables에 설정합니다.
NEXT_PUBLIC_SUPABASE_URL=https://mtmtjfbarvbhdmiyfqtr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Publishable key만 사용하세요. Secret/service_role 키는 넣지 않습니다.
# Playwright Chromium 대신 설치된 Edge를 사용할 때 셸에서 지정: PLAYWRIGHT_CHANNEL=msedge
# 테스트 설정은 이 파일을 자동으로 읽지 않습니다. Git Bash 실행 예:
# PLAYWRIGHT_CHANNEL=msedge npm run test:e2e
